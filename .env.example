# Database (SQLite by default; swap for Postgres in production)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- AI provider ---
# Which backend powers every AI feature (summary gen, rewriting, ATS scoring,
# job matching, cover letters, career recs, chat, resume import). Pick ONE:
#   gemini    (default, recommended if you don't have a paid key — genuinely
#              free, no credit card: https://aistudio.google.com/apikey)
#   groq      (also free-tier: https://console.groq.com/keys — fast, runs
#              open models like Llama)
#   anthropic (Claude — requires a paid Anthropic API key)
AI_PROVIDER="gemini"

# Fill in whichever ONE of these matches AI_PROVIDER above — the others can
# stay blank.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
